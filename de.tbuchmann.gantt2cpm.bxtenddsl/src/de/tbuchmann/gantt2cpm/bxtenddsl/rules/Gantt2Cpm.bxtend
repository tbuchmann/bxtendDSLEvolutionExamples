sourcemodel "http://de.ubt.ai1.bw.qvt.examples.gantt.ecore"
targetmodel "http://de.ubt.ai1.bw.qvt.examples.cpm.ecore"

// Gantt diagram (activities + dependencies) <-> CPM network (events + activities).
// A Gantt activity becomes a CPM activity between a start and an end event; a Gantt dependency becomes a
// CPM activity named "<predecessor>-><successor>" that connects events of the two activities.

// activity -> activity with its start (srcEvent) and end (trgEvent) event
rule Activity2Activity
	src Activity source;
	trg Activity target | filter;
		Event srcEvent | filter, creation;
		Event trgEvent | filter, creation; // a single filter here would result in less code and more runtime
	source.name <--> target.name;
	source.duration <--> target.duration;

// dependency -> connecting activity; the dependency type decides which events (start/end) are connected
rule Dependency2Activity
	src Dependency s;
	trg Activity t | filter;
	s.successor s.predecessor --> t.name;
	s.offset <--> t.duration;
	s.dependencyType {s.predecessor: Activity2Activity[srcEvent, trgEvent]} {s.successor: Activity2Activity[srcEvent,
	  trgEvent]} <--> t.sourceEvent t.targetEvent; // multiple unidirectional rules would be also possible for this

// diagram -> network
rule Diagram2Network
	src GanttDiagram s;
	trg CPMNetwork t;
	s.name <--> t.name;
	{s.elements: Activity2Activity, Dependency2Activity} <--> {t.elements: Activity2Activity, Dependency2Activity};
